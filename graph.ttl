    ex:departureDate "2026-05-19"^^xsd:date ;
    ex:durationMin 263 ;
    ex:fromBusyCountry true ;
    ex:operatedBy <http://example.org/mkr/airline/Orbit_Airways> ;
    ex:priceEur 116.99 .

<http://example.org/mkr/flight/FL-7729> a ex:LongFlight ;
    ex:arrivesAt <http://example.org/mkr/city/Krakow> ;
    ex:departsFrom <http://example.org/mkr/city/Warsaw> ;
    ex:departureDate "2026-07-15"^^xsd:date ;
    ex:durationMin 219 ;
    ex:operatedBy <http://example.org/mkr/airline/Blue_Meridian> .

<http://example.org/mkr/flight/FL-8045> a ex:BudgetFlight,
        ex:LongFlight ;
    ex:arrivesAt <http://example.org/mkr/city/Tallinn> ;
    ex:departsFrom <http://example.org/mkr/city/Kyiv> ;
    ex:departureDate "2026-03-19"^^xsd:date ;
    ex:durationMin 248 ;
    ex:fromBusyCountry true ;
    ex:operatedBy <http://example.org/mkr/airline/SkyNord> ;
    ex:priceEur 86.00 .

<http://example.org/mkr/flight/FL-9654> a ex:LongFlight ;
    ex:arrivesAt <http://example.org/mkr/city/Odesa> ;
    ex:departsFrom <http://example.org/mkr/city/Milan> ;
    ex:departureDate "2026-03-15"^^xsd:date ;
    ex:durationMin 201 ;
    ex:fromBusyCountry true ;
    ex:operatedBy <http://example.org/mkr/airline/TransCarpa> ;
    ex:priceEur 143.00 .

ex:fromBusyCountry a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range xsd:boolean .

ex:locatedIn a rdf:Property ;
    rdfs:domain ex:City ;
    rdfs:range ex:Country .

ex:operatedBy a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range ex:Airline .

ex:priceEur a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range xsd:decimal .

ex:reportedBy a rdf:Property ;
    rdfs:domain rdf:Statement ;
    rdfs:range rdfs:Resource .

<http://example.org/mkr/stmt/FL-5407-delay> a rdf:Statement ;
    ex:reportedBy <http://example.org/mkr/source/FlightLog> ;
    rdf:object 25 ;
    rdf:predicate ex:hasDelayMinutes ;
    rdf:subject <http://example.org/mkr/flight/FL-5407> .

<http://example.org/mkr/stmt/FL-6852-delay> a rdf:Statement ;
    ex:reportedBy <http://example.org/mkr/source/AirWatch> ;
    rdf:object 90 ;
    rdf:predicate ex:hasDelayMinutes ;
    rdf:subject <http://example.org/mkr/flight/FL-6852> .

<http://example.org/mkr/stmt/FL-8325-delay> a rdf:Statement ;
    ex:reportedBy <http://example.org/mkr/source/FlightLog> ;
    rdf:object 10 ;
    rdf:predicate ex:hasDelayMinutes ;
    rdf:subject <http://example.org/mkr/flight/FL-8325> .


@prefix ex: <http://example.org/mkr/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Airline a rdfs:Class .

ex:BudgetFlight a rdfs:Class ;
    rdfs:subClassOf ex:Flight .

ex:City a rdfs:Class .

ex:Country a rdfs:Class .

ex:Flight a rdfs:Class .

ex:LongFlight a rdfs:Class ;
    rdfs:subClassOf ex:Flight .

ex:arrivesAt a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range ex:City .

ex:departsFrom a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range ex:City .

ex:departureDate a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range xsd:date .

ex:durationMin a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range xsd:integer .

<http://example.org/mkr/flight/FL-1382> a ex:BudgetFlight ;
    ex:arrivesAt <http://example.org/mkr/city/Warsaw> ;
    ex:departsFrom <http://example.org/mkr/city/Lyon> ;
    ex:departureDate "2026-07-16"^^xsd:date ;
    ex:durationMin 79 ;
    ex:fromBusyCountry true ;
    ex:operatedBy <http://example.org/mkr/airline/Blue_Meridian> ;
    ex:priceEur 70.99 .

<http://example.org/mkr/flight/FL-2957> a ex:BudgetFlight,
        ex:LongFlight ;
    ex:arrivesAt <http://example.org/mkr/city/Berlin> ;
    ex:departsFrom <http://example.org/mkr/city/Lviv> ;
    ex:departureDate "2026-07-12"^^xsd:date ;
    ex:durationMin 249 ;
    ex:fromBusyCountry true ;
    ex:operatedBy <http://example.org/mkr/airline/Orbit_Airways> ;
    ex:priceEur 83.99 .

<http://example.org/mkr/flight/FL-3594> a ex:Flight ;
    ex:arrivesAt <http://example.org/mkr/city/Lyon> ;
    ex:departsFrom <http://example.org/mkr/city/Oslo> ;
    ex:departureDate "2026-03-28"^^xsd:date ;
    ex:durationMin 125 ;
    ex:fromBusyCountry true ;
    ex:operatedBy <http://example.org/mkr/airline/SkyNord> .

<http://example.org/mkr/flight/FL-4894> a ex:BudgetFlight ;
    ex:arrivesAt <http://example.org/mkr/city/Kyiv> ;
    ex:departsFrom <http://example.org/mkr/city/Rome> ;
    ex:departureDate "2026-04-07"^^xsd:date ;
    ex:durationMin 134 ;
    ex:fromBusyCountry true ;
    ex:operatedBy <http://example.org/mkr/airline/Zephyr_Lines> ;
    ex:priceEur 52.99 .

<http://example.org/mkr/flight/FL-4911> a ex:LongFlight ;
    ex:arrivesAt <http://example.org/mkr/city/Lviv> ;
    ex:departsFrom <http://example.org/mkr/city/Rome> ;
    ex:departureDate "2026-03-15"^^xsd:date ;
    ex:durationMin 302 ;
    ex:fromBusyCountry true ;
    ex:operatedBy <http://example.org/mkr/airline/Falcon_Jet> ;
    ex:priceEur 179.50 .

<http://example.org/mkr/flight/FL-5079> a ex:BudgetFlight,
        ex:LongFlight ;
    ex:arrivesAt <http://example.org/mkr/city/Warsaw> ;
    ex:departsFrom <http://example.org/mkr/city/Paris> ;
    ex:departureDate "2026-05-03"^^xsd:date ;
    ex:durationMin 197 ;
    ex:fromBusyCountry true ;
    ex:operatedBy <http://example.org/mkr/airline/SkyNord> ;
    ex:priceEur 85.99 .

<http://example.org/mkr/flight/FL-5433> a ex:LongFlight ;
    ex:arrivesAt <http://example.org/mkr/city/Milan> ;
    ex:departsFrom <http://example.org/mkr/city/Berlin> ;
    ex:departureDate "2026-03-11"^^xsd:date ;
    ex:durationMin 202 ;
    ex:fromBusyCountry true ;
    ex:operatedBy <http://example.org/mkr/airline/Lumen_Air> .

<http://example.org/mkr/flight/FL-5656> a ex:LongFlight ;
    ex:arrivesAt <http://example.org/mkr/city/Oslo> ;
    ex:departsFrom <http://example.org/mkr/city/Lisbon> ;
    ex:departureDate "2026-08-03"^^xsd:date ;
    ex:durationMin 311 ;
    ex:operatedBy <http://example.org/mkr/airline/Lumen_Air> ;
    ex:priceEur 240.00 .

<http://example.org/mkr/flight/FL-6348> a ex:LongFlight ;
    ex:arrivesAt <http://example.org/mkr/city/Prague> ;
    ex:departsFrom <http://example.org/mkr/city/Oslo> ;
    ex:departureDate "2026-05-06"^^xsd:date ;
    ex:durationMin 281 ;
    ex:fromBusyCountry true ;
    ex:operatedBy <http://example.org/mkr/airline/Lumen_Air> ;
    ex:priceEur 239.99 .

<http://example.org/mkr/flight/FL-7708> a ex:LongFlight ;
    ex:arrivesAt <http://example.org/mkr/city/Berlin> ;
